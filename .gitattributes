# Semua file PHP pakai LF
*.php text eol=lf

# Script shell, SQL, dan konfigurasi juga pakai LF
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf

# File web frontend
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# File teks umum
*.txt text eol=lf
*.md text eol=lf

# Windows-only file biarkan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf