function numFormat( cellvalue, options, rowObject )
{
	var weight = (eval(rowObject[7]));
	var qty = rowObject[1];
	var input = ''+weight / qty+'';
	if(!isNaN(input) && input!=Infinity){
		var num = input.replace(/\,/g,'');
		var n = num.indexOf('.');
		if( n > -1){
			return (eval(num.substring(0,n)) + eval(1))
   	} 
   	else 
   	{
    		return input;
   	}
   } 
   else 
   {
   	return "";
   }  
}

