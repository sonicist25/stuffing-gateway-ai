	function manage_data($data){
		$table = $data['table'];
		if($data['oper']=='add') {
			unset($data['oper']);
			unset($data['table']);
			$this->CI->db->insert($table,$data);
		}
		elseif($data['oper']=='edit') {
			unset($data['oper']);
			unset($data['table']);
			$this->CI->db->where('id',$data['id']);
			$this->CI->db->update($table,$data);
		}
		elseif($data['oper']=='del') {
			$this->CI->db->where('id',$data['id']);
			$this->CI->db->delete($table);
		}
		if($this->CI->db->affected_rows() > 0 ) {
    		return "1";
    		} else {
    		return "0";
    	}
	}
	
