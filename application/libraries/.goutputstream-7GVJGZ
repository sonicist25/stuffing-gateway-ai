	function get_prev_month($tgl){
		$thn = substr($tgl,0,4);
		$bln = substr($tgl,4,2);
		if($bln=='01'){$bln='12';$thn=$thn-1; return $thn.''.$bln;}
		if($bln=='02'){$bln='01';}
		if($bln=='03'){$bln='02';}
		if($bln=='04'){$bln='03';}
		if($bln=='05'){$bln='04';}
		if($bln=='06'){$bln='05';}
		if($bln=='07'){$bln='06';}
		if($bln=='08'){$bln='07';}
		if($bln=='09'){$bln='08';}
		if($bln=='10'){$bln='09';}
		if($bln=='11'){$bln='10';}
		if($bln=='12'){$bln='11';}
		return $thn.''.$bln;
	}

