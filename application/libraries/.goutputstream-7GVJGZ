   function auth($menu,$int){
   	$user = $this->CI->session->userdata('user_id');
   	if($user=='0') {
   		return true;	
   	} else {
   		$this->CI->db->select('user_id,user_menu');
   		$this->CI->db->from('mstadmin');
   		$this->CI->db->where('user_id',$user);
   		$this->CI->db->like('user_menu','+'.$menu.'+');
   		$query = $this->CI->db->get();
   		if($query->num_rows()==1) {
   			return true;
   		} else {
   			$this->CI->session->set_flashdata('restrict', str_replace('_',' ',$int));
				redirect(base_url('afg_c_stuffing_plan'),'refresh');
			}
   	}
   }
	
