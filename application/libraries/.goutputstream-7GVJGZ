				$query = $this->CI->db->get('x_finance');
				
    			if ($region == "Cikarang")
	 			{ 
	 				$thn= 'INC/'. date('y');
					$q = 6;}
				else if ($region == "Surabaya")
	 			{ 
	 				$thn= 'INS/'. date('y');
					$q = 6;
	 			}
	 			else if ($region == "Osline")
	 			{ 
	 				$thn= 'OSL/'. date('y');
					$q = 6;
	 			} else {
