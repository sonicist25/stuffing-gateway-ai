function get_data(input){
	$( '#loading-selling' ).ajaxStart(function(){
		$(this).fadeIn();
		$(this).html('<img src="<?php echo base_url("public/images/loader.gif")?>"/>');
		}).ajaxStop(function(){
		$(this).fadeOut();
	});
	
	$.ajax
	({
			type:"POST",
			url:"<?php echo base_url('pricelist/export_cost_price_agent/get_data') ?>",
			data:{ id : $( '#id' ).val(), oper : input, agent: $( '#agent' ).val()},
			success:function(data)
			{
				var data = $.parseJSON(data);
				$( '#id' ).val(data.id);
				$( '#ref_no' ).val(data.ref_no);
				$( '#date' ).val(data.date);
				$( '#valid' ).val(data.valid);
				$( '#agent' ).val(data.agent);
				
				if (data.ref_no=="") 
				{
					$("#btnEdit").attr("hidden",true);
				}	
				
				if (data.id_first==data.id) {
					$("#btnPrev").attr("hidden",true);
				}	else {
					$("#btnPrev").attr("hidden",false);
				}
				
				if (data.id_last==data.id) {
					$("#btnNext").attr("hidden",true);
				}	else {
					$("#btnNext").attr("hidden",false);
				}
				disabled_all()
				$("#table-satu-agent").jqGrid("setGridParam", {datatype: 'json',postData:{id_data : $( '#id' ).val(),}}).trigger("reloadGrid");
				table_satu_agent();
			},
	})		
}

