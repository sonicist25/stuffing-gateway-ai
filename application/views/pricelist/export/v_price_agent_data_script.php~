function exit_data(){
	$('#Form-Destination').dialog('close')
}

function cancel(){
	disabled_all();
	var input = $("#oper").val();
	if(input == 'add')
	{
		get_data('last');
		
	}
	else
	{
		get_data('pilih');
	}
}

function new_data(){
	$.ajax
	({
			type:"POST",
			url:"<?php echo base_url('pricelist/export_cost_price_agent/new_data') ?>",
			data:{ id : $( '#id' ).val(), agent: $( '#agent' ).val()},
			success:function(data)
			{
				var data = $.parseJSON(data);
				$( '#ref_no' ).val(data.ref_no);
			},
	})

	$( '#id' ).val('');
	$( '#date' ).val('');
	$( '#valid' ).val('');
	$( '#oper' ).val('add');
	
	$( '#btnDelete' ).attr('onClick','cancel("add")').val('CANCEL');
	$( '#idSelling' ).val('');
	$( '#operForm' ).val('add');
	$( '#table-satu-agent' ).jqGrid("clearGridData", true);
	enabled_all();
}

function edit_data(){
	enabled_all()
