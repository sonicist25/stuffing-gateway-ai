$(document).ready(function()
{
	$('#tabs-lading .the-tab').hide();
	$('#tabs-lading div:first').show();
	$('#tabs-lading ul li:first').addClass('active');
 
	$('#tabs-lading ul li a').click(function(){
		$('#tabs-lading ul li').removeClass('active');
		$(this).parent().addClass('active');
		var currentTab = $(this).attr('href');
		$('#tabs-lading .the-tab').hide();
		$(currentTab).show();
		return false;
	});
	
	disabled_all();
	$('#date').datepicker({dateFormat: 'dd/mm/yy'});	
	$('#valid').datepicker({dateFormat: 'dd/mm/yy'});	
	$('#btnDelete').attr('href','#');	
	$('#btnExit').hide();	
	get_data('last');	
});

function save_data()
{
	
	var myData = 
	{
		id 			: $('#id').val(),
		oper 			: $('#oper').val(),
		ref_no		: $('#ref_no' ).val(),
		date        : $("#date").val(),
		valid			: $('#valid').val(),
		agent			: $('#agent').val(),
	}
	var tanggal = $( '#date' ).val();
	var valid   = $( '#valid' ).val();
	if (tanggal == '' || valid == '')
	{
		show_messages('Input \"Date / Valid\" Empty Value');
		return false;
	}
	else
	{
		$.ajax
		({
			type: "POST",
			url : "<?php echo base_url('pricelist/export_cost_price_agent/manage_data_header')?>",
			data : myData,
			success: function(response)
			{
				var data = $.parseJSON(response);
				if(data.status == 1 || data.oper=="add")
				{
					get_data('last');
				}
				else if(data.status == 1 || data.oper=="edit")
				{
					get_data('pilih');
				}
				else if(data.status == 1 || data.oper=="del")
				{
					get_data('last');
					$('#delete-confirm').dialog('close');
				}
				else
				{
					get_data('pilih');
				};
			},
			error:function()
			{
				var message = '<div id="content-msg">ERROR ACCOURED</div>';
				show_messages(message);
				get_data('pilih');
			}
		});
	}
}

function disabled_all()
{

	$( '#btnNew' ).attr('disabled',false);
	$( '#btnEdit' ).attr('disabled',false);
	$( '#btnNext' ).attr('disabled',false);
	$( '#btnPrev' ).attr('disabled',false);
	$( '#btnSave' ).attr('disabled',true);
	$( '#btnDelete' ).attr('onClick','delete_data()').val('DELETE');
	$( '#btnExit' ).hide().attr('onClick','exit_data()').val('EXIT');
	
	$( '#ref_no' ).attr('disabled',true);
	$( '#date' ).attr('disabled',true);
	$( '#valid' ).attr('disabled',true);
}

function enabled_all()
{
	$( '#btnNew' ).attr('disabled',true);
	$( '#btnEdit' ).attr('disabled',true);
	$( '#btnNext' ).attr('disabled',true);
	$( '#btnPrev' ).attr('disabled',true);
	$( '#btnSave' ).attr('disabled',false);
	$( '#btnExit' ).show().attr('disabled',false).val(' SAVE ').attr('onClick','save_data()');
	
	$( '#date' ).attr('disabled',false);
	$( '#valid' ).attr('disabled',false);
}

